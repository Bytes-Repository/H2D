[package]
-> name        => h2d
-> version     => 0.1.0
-> description => 2D game engine for H# (character-grid / ANSI truecolor renderer, entities, tilemaps, turn-based input)
-> author      => Bytes Developers
-> license     => MIT

[build]
-> lang   => h#
-> entry  => src/lib.h#
-> output => build/libh2d
-> emit   => lib

[deps]
