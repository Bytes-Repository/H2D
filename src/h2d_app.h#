mod h2d_canvas
mod h2d_entity
mod h2d_timer

pub struct App is
    pub canvas:  h2d_canvas::Canvas
    pub world:   h2d_entity::World
    pub clock:   h2d_timer::Clock
    pub running: bool
    pub turn:    int
end

pub fn new_app(width: int, height: int) -> App is
    return App {
        canvas: h2d_canvas::new_canvas(width, height),
        world: h2d_entity::new_world(),
        clock: h2d_timer::new_clock(),
        running: true,
        turn: 0,
    }
end

pub fn quit(mut app: App) -> App is
    app.running = false
    return app
end

pub fn next_turn(mut app: App) -> App is
    app.turn += 1
    return app
end

pub fn shutdown(app: App) is
    h2d_canvas::shutdown(app.canvas)
end
